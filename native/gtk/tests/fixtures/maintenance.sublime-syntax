%YAML 1.2
---
name: Maintenance fixture
file_extensions: [maintenance]
scope: source.maintenance
contexts:
  main:
    - match: '\b(let|fn)\b'
      scope: keyword.control.maintenance
    - match: '"'
      scope: punctuation.definition.string.begin.maintenance
      push: quoted
    - match: '\d+'
      scope: constant.numeric.maintenance
  quoted:
    - meta_scope: string.quoted.double.maintenance
    - match: '"'
      scope: punctuation.definition.string.end.maintenance
      pop: true
