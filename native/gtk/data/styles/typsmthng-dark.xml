<?xml version="1.0" encoding="UTF-8"?>
<!--
  typsmthng dark scheme: Adwaita-dark plus Typst-specific styles.

  Prose keeps the base text colour. Code uses a One-like palette (purple
  keywords, blue functions, green strings, orange numbers). Math sits on a
  faint violet wash with its own inks (italic indigo variables, teal symbols,
  magenta delimiters and relations) so equations read apart from prose.
  Headings are bold and underlined with dimmed `=` markers. Every foreground
  meets WCAG AA (4.5:1) against the editor background.
-->
<style-scheme id="typsmthng-dark" name="typsmthng Dark" version="1.0" parent-scheme="Adwaita-dark">
  <author>typsmthng</author>
  <description>Adwaita-dark with Typst markup, code and math styles</description>

  <metadata>
    <property name="variant">dark</property>
    <property name="light-variant">typsmthng-light</property>
  </metadata>

  <!-- Palette -->
  <color name="heading"       value="#F4F3F5"/>
  <color name="heading_rule"  value="#4F6E9E"/>
  <color name="dim"           value="#9C9BA1"/>
  <color name="soft"          value="#B3B1B7"/>
  <color name="orange"        value="#E0A26A"/>
  <color name="raw"           value="#86C9B4"/>
  <color name="purple"        value="#C98AE8"/>
  <color name="blue"          value="#6FB0F2"/>
  <color name="cyan"          value="#6CC4D6"/>
  <color name="green"         value="#9CCB7F"/>
  <color name="red"           value="#EE8388"/>
  <color name="math_wash"     value="#2E2A36"/>
  <color name="magenta"       value="#F08AB8"/>
  <color name="violet"        value="#B99BD8"/>
  <color name="indigo"        value="#A9B4FF"/>
  <color name="teal"          value="#6CCFC6"/>
  <color name="teal_soft"     value="#A3C4C1"/>

  <!-- Markup -->
  <style name="typst:heading"             foreground="heading" bold="true" underline="single" underline-color="heading_rule"/>
  <style name="typst:heading-marker"      foreground="dim" bold="false" underline="none"/>
  <style name="typst:strong"              bold="true"/>
  <style name="typst:emph"                italic="true"/>
  <style name="typst:term"                bold="true"/>
  <style name="typst:list-marker"         foreground="orange" bold="true"/>
  <style name="typst:raw"                 foreground="raw"/>
  <style name="typst:raw-block"           foreground="raw"/>
  <style name="typst:raw-delimiter"       foreground="dim"/>
  <style name="typst:raw-lang"            foreground="purple"/>
  <style name="typst:link"                foreground="blue" underline="low"/>
  <style name="typst:label"               foreground="cyan"/>
  <style name="typst:ref"                 foreground="cyan" underline="low"/>
  <style name="typst:escape"              foreground="cyan"/>
  <style name="typst:shorthand"           foreground="cyan"/>
  <style name="typst:linebreak"           foreground="cyan" bold="true"/>
  <style name="typst:comment"             foreground="dim" italic="true"/>

  <!-- Code -->
  <style name="typst:keyword"             foreground="purple"/>
  <style name="typst:boolean"             foreground="orange"/>
  <style name="typst:constant"            foreground="orange"/>
  <style name="typst:number"              foreground="orange"/>
  <style name="typst:string"              foreground="green"/>
  <style name="typst:string-escape"       foreground="cyan"/>
  <style name="typst:function"            foreground="blue"/>
  <style name="typst:interpolated"        foreground="red"/>
  <style name="typst:named-argument"      foreground="soft" italic="true"/>
  <style name="typst:operator"            foreground="cyan"/>
  <style name="typst:punctuation"         foreground="dim"/>

  <!-- Math -->
  <style name="typst:math"                background="math_wash"/>
  <style name="typst:math-delimiter"      foreground="magenta" bold="true"/>
  <style name="typst:math-operator"       foreground="magenta"/>
  <style name="typst:math-alignment"      foreground="magenta" bold="true"/>
  <style name="typst:math-attach"         foreground="violet"/>
  <style name="typst:math-group"          foreground="dim"/>
  <style name="typst:math-variable"       foreground="indigo" italic="true"/>
  <style name="typst:math-symbol"         foreground="teal"/>
  <style name="typst:math-modifier"       foreground="teal_soft"/>
  <style name="typst:math-function"       foreground="blue"/>
  <style name="typst:math-number"         foreground="orange"/>
  <style name="typst:math-string"         foreground="green"/>
  <style name="typst:math-named-argument" foreground="soft" italic="true"/>

</style-scheme>
